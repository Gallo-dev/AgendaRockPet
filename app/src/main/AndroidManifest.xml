<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- configuraaoo para acessar a camera do celular -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-permission android:name="android.permission.CAMERA" /> <!-- // permissao para acessar a galeria do celular -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".data.AppDataBase.PetApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/foto_cachorro"
        android:label="@string/app_name"
        android:roundIcon="@drawable/foto_cachorro"
        android:supportsRtl="true"
        android:theme="@style/Base.Theme.AgendaPet"
        tools:targetApi="31">
        <activity
            android:name=".presentation.Login.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.agendamentos.AgendamentoActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.detalhesCliente.ListaDetalhesActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.splashScreen.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.formularioCliente.FormularioClienteActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.ListCliente.ListaClientesActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>