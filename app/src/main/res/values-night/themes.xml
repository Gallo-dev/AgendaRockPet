<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AgendaPet" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Customize your dark theme here. -->
        <item name="android:statusBarColor">@color/blueAgendaPet</item>
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/blueAgendaPet</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#000000</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="android:datePickerStyle">@style/DataPickerFragment</item>
        <item name="android:timePickerStyle">@style/HoraPickerFragment</item>

    </style>

    <style name="DataPickerFragment" parent="@style/Theme.AppCompat.Light">
        <item name="android:datePickerMode">calendar</item>
        <item name="android:headerBackground">@color/blueAgendaPet</item>
        <item name="android:calendarTextColor">@color/black</item>
        <item name="android:numbersInnerTextColor">@color/white</item>
        <item name="android:numbersSelectorColor">@color/blueAgendaPet</item>

    </style>
    <style name="HoraPickerFragment" parent="@style/Theme.AppCompat.Light">

        <item name="android:timePickerMode">clock</item>
        <item name="android:headerBackground">@color/blueAgendaPet</item>
        <item name="android:numbersSelectorColor">@color/blueAgendaPet</item>
        <item name="android:numbersInnerTextColor">@color/white</item>
        <item name="android:numbersTextColor">@color/black</item>

    </style>
</resources>