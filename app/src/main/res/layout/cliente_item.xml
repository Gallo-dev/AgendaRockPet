<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="15dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lightBlue">

        <ImageView
            android:id="@+id/imagem_item_animal"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_margin="8dp"
            android:layout_marginTop="8dp"
            android:background="@color/white"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toStartOf="@id/nome_cliente_formulario"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <TextView
            android:id="@+id/nome_cliente_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_medium"
            android:text="Nomeo do tutor:"
            android:textColor="@color/black"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/imagem_item_animal"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/nome_cliente_formulario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/nome_cliente_titulo"
            app:layout_constraintTop_toBottomOf="@id/nome_cliente_titulo"
            tools:text="Lucas Gallo" />

        <TextView
            android:id="@+id/data_atendimento_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_medium"
            android:text="Data:"
            android:textColor="@color/black"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/imagem_item_animal"
            app:layout_constraintTop_toBottomOf="@id/nome_cliente_formulario" />

        <TextView
            android:id="@+id/data_atendimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/nome_cliente_titulo"
            app:layout_constraintTop_toBottomOf="@id/data_atendimento_titulo"
            tools:text="20/02/2025" />

        <TextView
            android:id="@+id/hora_atendimento_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_medium"
            android:text="Horario:"
            android:textColor="@color/black"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@id/nome_animal_titulo"
            app:layout_constraintTop_toBottomOf="@id/nome_cliente_formulario" />

        <TextView
            android:id="@+id/hora_atendimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/hora_atendimento_titulo"
            app:layout_constraintTop_toBottomOf="@id/data_atendimento_titulo"
            tools:text="15:30" />


        <TextView
            android:id="@+id/nome_animal_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/roboto_medium"
            android:text="Nome do animal:"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/nome_cliente_titulo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/nome_cliente_titulo" />

        <TextView
            android:id="@+id/nome_animal_formulario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/nome_animal_titulo"
            app:layout_constraintTop_toBottomOf="@id/nome_animal_titulo"
            tools:text="Khaleesi" />

        <TextView
            android:id="@+id/telefone_cliente_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/roboto_medium"
            android:text="Telefone:"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imagem_item_animal"
            app:layout_constraintTop_toBottomOf="@id/data_atendimento" />

        <TextView
            android:id="@+id/telefone_cliente_formulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/telefone_cliente_titulo"
            app:layout_constraintTop_toBottomOf="@id/telefone_cliente_titulo"
            tools:text="(15)988776655" />

        <TextView
            android:id="@+id/email_cliente_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/roboto_medium"
            android:text="E-mail:"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/imagem_item_animal"
            app:layout_constraintTop_toBottomOf="@id/telefone_cliente_formulario" />

        <TextView
            android:id="@+id/email_cliente_formulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/email_cliente_titulo"
            app:layout_constraintTop_toBottomOf="@id/email_cliente_titulo"
            tools:text="lucas_gallo@outlook.com" />

        <TextView
            android:id="@+id/observacao_cliente_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/roboto_medium"
            android:text="Observação:"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/imagem_item_animal"
            app:layout_constraintTop_toBottomOf="@id/email_cliente_formulario" />

        <TextView
            android:id="@+id/observacao_cliente_formulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="8dp"
            app:layout_constraintStart_toStartOf="@id/imagem_item_animal"
            app:layout_constraintTop_toBottomOf="@id/observacao_cliente_titulo"
            tools:text="A Khaleesi é uma gata de 2 anos, muito brincalhona e carinhosa." />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
